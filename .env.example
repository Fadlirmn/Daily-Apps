# Salin ke .env lalu isi nilai asli. .env tidak di-commit (lihat .gitignore).
# Semua variabel di bawah WAJIB diisi — compose dan server akan refuse start tanpa ini.

POSTGRES_DB=fintrack
POSTGRES_USER=fintrack
# Password database. Generate contoh: openssl rand -hex 24
POSTGRES_PASSWORD=

# Secret untuk sign/verify JWT. WAJIB unik per environment, jangan pakai contoh.
# Generate contoh: openssl rand -hex 32
JWT_SECRET=

# Opsional. Daftar origin yang diizinkan CORS, pisahkan dengan koma.
# Kosongkan untuk dev lokal (CORS terbuka). Isi untuk production, mis:
# CORS_ORIGIN=https://arunika.example.com
CORS_ORIGIN=
